// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Company {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  customers Customer[]
  tasks     Task[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])

  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks     Task[]            @relation("AssignedTasks")
  createdTasks      Task[]            @relation("CreatedTasks")
  statusChanges     TaskStatusHistory[]
  attendanceRecords Attendance[]
  locationHistory   LocationTracking[]
  uploadedAttachments TaskAttachment[]
  notifications       Notification[]

  @@index([companyId])
  @@map("users")
}

model Customer {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  name      String
  phone     String?
  email     String?
  address   String
  latitude  Float?
  longitude Float?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]

  @@index([companyId])
  @@map("customers")
}
model Task {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])

  title       String
  description String?

  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id])

  assignedToId String?
  assignedTo   User?       @relation("AssignedTasks", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User         @relation("CreatedTasks", fields: [createdById], references: [id])

  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)

  dueDate           DateTime?
  estimatedDuration Int?
  actualDuration    Int?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  statusHistory TaskStatusHistory[]
  locationHistory LocationTracking[]
  attachments   TaskAttachment[]

  @@index([companyId])
  @@index([assignedToId])
  @@index([customerId])
  @@index([status])
  @@map("tasks")
}

model TaskStatusHistory {
  id        String     @id @default(uuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id])

  status    TaskStatus
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])

  notes     String?
  createdAt DateTime   @default(now())

  @@index([taskId])
  @@map("task_status_history")
}

model Attendance {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  date        DateTime  @db.Date
  checkIn     DateTime
  checkOut    DateTime?

  checkInLat  Float?
  checkInLng  Float?
  checkOutLat Float?
  checkOutLng Float?

  workingMinutes Int?

  createdAt   DateTime  @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@map("attendance")
}

model LocationTracking {
  id        String   @id @default(uuid())
  employeeId String
  employee   User    @relation(fields: [employeeId], references: [id])

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])

  latitude  Float
  longitude Float

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([taskId])
  @@map("location_tracking")
}

enum AttachmentType {
  BEFORE
  DURING
  AFTER
  OTHER
}

model TaskAttachment {
  id         String         @id @default(uuid())
  taskId     String
  task       Task           @relation(fields: [taskId], references: [id])

  fileUrl    String
  fileName   String
  type       AttachmentType @default(OTHER)

  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  createdAt  DateTime       @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

enum NotificationType {
  NEW_TASK
  TASK_REASSIGNED
  TASK_STATUS_CHANGED
  TASK_DUE_SOON
  ISSUE_REPORTED
  MANAGER_MESSAGE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])

  title     String
  message   String
  type      NotificationType

  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@map("notifications")
}